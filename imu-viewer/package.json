{
  "name": "imu-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "node scripts/version.cjs && vite build --mode development",
    "build": "node scripts/version.cjs && vite build --mode production",
    "package": "npm run clean && npm run build && node scripts/package.js",
